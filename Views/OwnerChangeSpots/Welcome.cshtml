@model Parking.Models.OwnerChangeSpotsViewModel

<div class="container mt-4">
    <h2>Καλώς ήρθατε, @Model.OwnerName!</h2>

    <form asp-action="Welcome" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <p>Ακολουθούν τα στοιχεία του Parking σας.</p>

        <p>Τοποθεσία: @Model.Location</p>
        <p>Μέγιστο πλήθος θέσεων: @Model.TotalSpots</p>
        <p>Ελεύθερες θέσεις αυτή τη στιγμή: @Model.FreeSpots</p>

        <h5>
            Στο ακόλουθο πεδίο θα δείτε τον αριθμό των κρατημένων θέσεων αυτή τη στιγμή.
            Πατήστε για να τον αλλάξετε, εφόσον το επιθυμείτε.
        </h5>

        <div class="mb-3">
            <label asp-for="ReservedSpots" class="form-label">
                Κρατημένες θέσεις
            </label>

            <input asp-for="ReservedSpots" class="form-control" />

            <span asp-validation-for="ReservedSpots" class="text-danger"></span>
        </div>

        @* Στέλνει το ParkingId στη μέθοδο POST Welcome *@
        <input type="hidden" asp-for="ParkingId" />

        <a asp-action="Welcome"
           class="btn btn-danger btn-lg shadow-sm"
           style="width: 180px;">
            Ακύρωση
        </a>

        <button type="submit"
                class="btn btn-success btn-lg shadow-sm"
                style="width: 180px;">
            Επιβεβαίωση
        </button>
    </form>
</div>